# Bloco a adicionar no Caddyfile do projeto docs-site (VPS).
# Após adicionar: `caddy validate` e reload graceful. Ver deploy/README.md.
#
# ROTEAMENTO: um único domínio serve DUAS coisas:
#   /            → landing (proxy reverso para a Vercel; a URL final continua .campello.me,
#                  NÃO é redirect — o cliente nunca vê o domínio da Vercel).
#   /mcp         → conector MCP, SEMPRE com chave de acesso (sem acesso indiscriminado).
#                  A mesma chave (MCP_BEARER_TOKEN) é aceita de DUAS formas:
#                    a) header `Authorization: Bearer <chave>` — clientes que enviam header
#                       (ex.: Claude Code);
#                    b) chave embutida na URL: /mcp/<chave> — é o caminho para o conector
#                       personalizado do claude.ai (web/desktop/mobile), que NÃO envia header
#                       customizado (só suporta OAuth ou nenhum auth).
#                  Sem chave válida → 401.
#   /health      → healthcheck do container (público, não expõe nada).
#
# A chave vive no .env do docs-site (MCP_BEARER_TOKEN) e é injetada no container Caddy na
# SUBIDA — gere/rotacione com deploy/rotate-bearer.sh (que recria o container Caddy).
# O default `:unset` abaixo evita que a env ausente vire uma chave vazia (gate aberto).
#
# Trade-off consciente da forma (b): a chave aparece na URL (e portanto em logs de acesso).
# Aceitável aqui — ferramentas somente-leitura servindo base já pública; a chave existe para
# controlar QUEM acessa (distribuição via contato), e é rotacionável a custo zero.

leadership-mcp.campello.me {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# (b) Chave na URL — conector personalizado do claude.ai (web/desktop/mobile).
	# Reescreve para /mcp antes de proxear (o servidor só conhece /mcp).
	# Streamable HTTP usa SSE de longa duração — sem timeout no upstream.
	@mcp_keyed_url path /mcp/{$MCP_BEARER_TOKEN:unset} /mcp/{$MCP_BEARER_TOKEN:unset}/*
	handle @mcp_keyed_url {
		uri replace /mcp/{$MCP_BEARER_TOKEN:unset} /mcp
		reverse_proxy leadership-mcp:3000 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# (a) Bearer no header — Claude Code e outros clientes que enviam header.
	@mcp_bearer {
		path /mcp /mcp/*
		header Authorization "Bearer {$MCP_BEARER_TOKEN:unset}"
	}
	handle @mcp_bearer {
		reverse_proxy leadership-mcp:3000 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# Qualquer outro acesso a /mcp: sem chave → 401.
	@mcp_denied path /mcp /mcp/*
	handle @mcp_denied {
		respond 401 {
			body "Unauthorized"
			close
		}
	}

	# Healthcheck.
	handle /health {
		reverse_proxy leadership-mcp:3000
	}

	# Landing: proxy reverso para a Vercel. A Vercel roteia pelo Host, então sobrescrevemos o Host
	# para o domínio do projeto (o Caddy disca por TLS com SNI = leadership-mcp.vercel.app).
	handle {
		reverse_proxy https://leadership-mcp.vercel.app {
			header_up Host leadership-mcp.vercel.app
		}
	}
}
