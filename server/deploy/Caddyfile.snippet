# Bloco a adicionar no Caddyfile do projeto docs-site (VPS).
# Após adicionar: `caddy validate` e reload graceful. Ver deploy/README.md.
#
# ROTEAMENTO: um único domínio serve DUAS coisas:
#   /            → landing (proxy reverso para a Vercel; a URL final continua .campello.me,
#                  NÃO é redirect — o cliente nunca vê o domínio da Vercel).
#   /mcp, /mcp/* → conector MCP — PROXY PURO. A autenticação por lote de tokens (Bearer ou
#                  token embutido na URL /mcp/<token>) vive inteiramente no Node
#                  (server/auth.js) — o Caddy não valida mais nada aqui. Isso permite
#                  criar/revogar token na hora, sem tocar no Caddy nem reiniciar nada dele.
#   /health      → healthcheck do container (público, não expõe nada).
#
# Por que a auth saiu do Caddy: com uma chave única (MCP_BEARER_TOKEN), o Caddy conseguia
# validar via matcher de header/path. Um LOTE de tokens (um por pessoa, revogável
# individualmente) não dá pra expressar em matchers estáticos do Caddyfile — o token válido
# muda em runtime. Delegar ao Node (que já recebe a request) resolve isso sem dependência nova.
#
# Trade-off consciente mantido: a chave na URL (/mcp/<token>) aparece em logs de acesso do
# Caddy. Aceitável — ferramentas somente-leitura servindo base já pública; a telemetria do Node
# agora permite identificar e revogar um token vazado.

leadership-mcp.campello.me {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# /mcp e /mcp/<token> — proxy puro para o Node. Streamable HTTP usa SSE de longa
	# duração — sem timeout no upstream.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy leadership-mcp:3000 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# Healthcheck.
	handle /health {
		reverse_proxy leadership-mcp:3000
	}

	# Landing: proxy reverso para a Vercel. A Vercel roteia pelo Host, então sobrescrevemos o Host
	# para o domínio do projeto (o Caddy disca por TLS com SNI = leadership-mcp.vercel.app).
	handle {
		reverse_proxy https://leadership-mcp.vercel.app {
			header_up Host leadership-mcp.vercel.app
		}
	}
}
